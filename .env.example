# Copy this file to .env for local development (never commit .env).
# On Render, set the same variables under Environment instead.

# Branding shown in the site header, titles and legal page.
SITE_NAME=MockExam
# Optional: shown on the About & legal page for data-deletion requests.
CONTACT_EMAIL=

# --- Supabase (optional; without it, tests load from content/ and attempts go to SQLite) ---
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) or the legacy anon key.
SUPABASE_KEY=
# Long random secret; its SHA-256 hash must be stored in private.app_secrets (see supabase/schema.sql).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPABASE_APP_SECRET=

# --- AI writing examiner (optional; without it, writing gets automatic feedback only) ---
ANTHROPIC_API_KEY=
# Model and effort used for marking. claude-opus-5 gives the most reliable marking;
# claude-sonnet-5 costs less per script.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
# Cost controls for AI marking.
AI_PER_IP_PER_HOUR=6
AI_DAILY_LIMIT=300
AI_MAX_CONCURRENT=4

# --- Accounts ---
# Public address of the site (used for sign-in and payment return links).
SITE_URL=https://ielts-mock-exam.onrender.com
# Emails that get the admin panel (#/admin), comma-separated.
ADMIN_EMAILS=
# Optional: secret that signs sign-in cookies. If empty, one is derived from SUPABASE_APP_SECRET.
SESSION_SECRET=
# Local development only: return sign-in codes in the API response instead of emailing them.
# AUTH_DEV_CODES=1

# --- Prices (so'm) ---
PLAN_PRICE=39000
PLAN_DAYS=30
# Extra free days on a user's first paid month ("first month + 1 month free").
PLAN_FIRST_BONUS_DAYS=30
WRITING_CHECK_PRICE=10000
SPEAKING_CHECK_PRICE=20000

# --- Payme (Business cabinet → your cash desk → Developers) ---
# Endpoint to register in the cabinet: https://YOUR-SITE/api/pay/payme  (account field: order_id)
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 = use the Payme test checkout (with your test key).
PAYME_TEST=0
PAYME_ACCOUNT_FIELD=order_id
# Optional fiscal receipt data (MXIK code and package code of your service).
PAYME_IKPU=
PAYME_PACKAGE_CODE=

# --- Click (merchant.click.uz → your service) ---
# Prepare URL: https://YOUR-SITE/api/pay/click/prepare   Complete URL: https://YOUR-SITE/api/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Card transfer (manual payments until Payme/Click are connected) ---
# Students transfer to this card and press "I have paid"; an admin confirms in #/admin.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=

# --- Admin endpoints (/api/admin/stats, /api/admin/refresh) ---
# Use a long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Local SQLite file used when Supabase is not configured.
# SQLITE_PATH=data/local.sqlite3

# Rate limiting reads the client IP from the proxy's X-Forwarded-For header.
# Set to 0 if the server is exposed directly to the internet without a proxy.
TRUST_PROXY=1

PORT=8080
