# Copy this file to .env for local development (never commit .env).
# On Render, set the same variables under Environment instead.

# Branding shown in the site header, titles and legal page.
SITE_NAME=TestDay
# Support address students see on the About, Privacy, Terms and Refund pages (data deletion, refunds).
# Set it before payments go live; when empty, the pages fall back to the site's other contact.
CONTACT_EMAIL=
# Social links in the site footer (full https:// addresses). Leave a line empty to hide that link.
SOCIAL_TELEGRAM=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=

# --- Supabase (optional; without it, tests load from content/ and attempts go to SQLite) ---
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) or the legacy anon key.
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY is read instead when SUPABASE_KEY is empty (not recommended: the publishable key is enough).
# SUPABASE_SERVICE_ROLE_KEY=
# Long random secret; its SHA-256 hash must be stored in private.app_secrets (see supabase/schema.sql).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPABASE_APP_SECRET=

# --- AI examiner, through OpenRouter (optional; without it, Writing gets automatic feedback only
# and Speaking has no AI examiner). Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# The model (Speaking needs one that accepts audio) and how long it thinks: low, medium or high.
AI_MODEL=google/gemini-3.8-flash
AI_REASONING=medium
# Each step can use its own model (docs/COSTS.md has the comparison). Leave unset for the tested defaults:
# AI_MODEL_LISTEN=google/gemini-3.1-flash-lite     listening to each Speaking answer (must accept audio)
# AI_MODEL_RATE=google/gemini-3.8-flash            rating the whole Speaking test from its transcripts
# AI_MODEL_WRITING=google/gemini-3.1-flash-lite    marking each Writing task
# AI_MODEL_FALLBACK=google/gemini-3.8-flash        tried once when the chosen model keeps failing
# Only model providers that do not keep or train on what we send: deny (default; falls back with a loud log line if
# none qualifies), strict (never falls back), or allow.
AI_DATA_COLLECTION=deny
# Site-wide cost controls for Writing marking.
AI_PER_IP_PER_HOUR=6
AI_DAILY_LIMIT=300
AI_MAX_CONCURRENT=4
SPEAKING_AI_DAILY_LIMIT=150
# Each person's AI allowance (mockexam/ai_usage.py; the sums are in docs/COSTS.md). With a pass for the paper:
WRITING_AI_PER_MONTH=30
WRITING_AI_PER_DAY=3
SPEAKING_AI_PER_MONTH=30
SPEAKING_AI_PER_DAY=3
# A free account: this many, once (they do not come back):
WRITING_AI_FREE_TOTAL=1
SPEAKING_AI_FREE_TOTAL=1
# All free accounts together, a day (protects the AI budget from a flood of new accounts):
AI_FREE_WRITING_PER_DAY=40
AI_FREE_SPEAKING_PER_DAY=15
# Spending net per person per paper in any 30 days, in US dollars (pass / free):
AI_COST_CAP_WRITING_USD=2.0
AI_COST_CAP_SPEAKING_USD=3.0
AI_FREE_COST_CAP_WRITING_USD=0.3
AI_FREE_COST_CAP_SPEAKING_USD=0.5
# The AI examiner adapts the Speaking test to the candidate (7-9 questions in Part 1, 3-10 in Part 3). 0 = the usual test.
SPEAKING_ADAPTIVE=1

# --- Accounts ---
# Public address of the site (used for sign-in and payment return links).
SITE_URL=https://ielts-mock-exam.onrender.com
# Emails that get the admin panel (#/admin), comma-separated.
ADMIN_EMAILS=
# Optional: secret that signs sign-in cookies. If empty, one is derived from SUPABASE_APP_SECRET.
SESSION_SECRET=
# Local development only: return sign-in codes in the API response instead of emailing them.
# AUTH_DEV_CODES=1
# Optional: "Continue with Google" in the sign-in window. The Client ID of a Google OAuth client of type
# "Web application" (see DEPLOY.md, "Sign in with Google"). It is public; there is no client secret.
GOOGLE_CLIENT_ID=

# --- Prices (so'm) ---
PLAN_DAYS=30
# Extra free days on a user's first paid month ("first month + 1 month free").
PLAN_FIRST_BONUS_DAYS=30
WRITING_CHECK_PRICE=10000
SPEAKING_CHECK_PRICE=20000

# --- Speaking recordings ---
# Recordings are deleted this many days after the test (never while an examiner is marking them).
SPEAKING_KEEP_DAYS=30
# Limits per student per day.
SPEAKING_TESTS_PER_DAY=8
SPEAKING_UPLOAD_MB_PER_DAY=80

# --- Payme (Business cabinet → your cash desk → Developers) ---
# Endpoint to register in the cabinet: https://YOUR-SITE/api/pay/payme  (account field: order_id)
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 = use the Payme test checkout (with your test key).
PAYME_TEST=0
PAYME_ACCOUNT_FIELD=order_id
# Optional fiscal receipt data (MXIK code and package code of your service).
PAYME_IKPU=
PAYME_PACKAGE_CODE=
# VAT on the receipt: 0 while the business pays turnover tax (not VAT); the unit code only if the MXIK entry has one.
PAYME_VAT_PERCENT=0
PAYME_UNITS=

# --- Click (merchant.click.uz → your service) ---
# Prepare URL: https://YOUR-SITE/api/pay/click/prepare   Complete URL: https://YOUR-SITE/api/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Optional: lets Admin → Orders → Refund return the money through Click's Merchant API (otherwise return it in the Click cabinet).
CLICK_MERCHANT_USER_ID=
# Only if Click calls a relay in front of the site (see docs/PAYMENTS_CHECKLIST.md, section 8): its address, shown in Admin → Click.
CLICK_CALLBACK_BASE=

# --- Notifications (optional) ---
# Emails to students (payment received, marks ready), examiners (new check) and ADMIN_EMAILS (payments).
# Resend: create an API key and verify your sending domain at https://resend.com.
RESEND_API_KEY=
EMAIL_FROM=TestDay <noreply@your-domain.uz>
# Telegram messages to you: create a bot with @BotFather, send it any message, then put your chat id here
# (open https://api.telegram.org/bot<TOKEN>/getUpdates to see it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Admin endpoints (/api/admin/stats, /api/admin/refresh) ---
# Use a long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Local SQLite file used when Supabase is not configured.
# SQLITE_PATH=data/local.sqlite3

# Rate limiting reads the client IP from the proxy's X-Forwarded-For header.
# Set to 0 if the server is exposed directly to the internet without a proxy.
TRUST_PROXY=1

PORT=8080

# Examiner checks (a paid review by a human examiner) stay off until you have examiners: 1 to offer them.
EXAMINER_CHECKS_ENABLED=0

# --- Card payments in US dollars: Dodo Payments (see docs/PAYMENTS_CHECKLIST.md, section 7) ---
# dodo_test_... uses the test servers, dodo_live_... the live ones.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# The product of each pass: kind of pass, a dash, the months.
DODO_PRODUCTS=full-1=pdt_xxx,full-3=pdt_xxx,speaking-1=pdt_xxx,speaking-3=pdt_xxx,writing-1=pdt_xxx,writing-3=pdt_xxx,lr-1=pdt_xxx,lr-3=pdt_xxx

# --- Protection against floods and runaway bills (mockexam/guard.py, docs/SECURITY.md) ---
# Behind Cloudflare: believe its CF-Connecting-IP header (only from Cloudflare's network), and refuse requests that
# do not carry the secret header Cloudflare adds (set the same value in a Cloudflare Transform Rule).
# TRUST_CLOUDFLARE=1
# ORIGIN_SECRET=
# Robot check before a sign-in code is emailed (Cloudflare Turnstile; both keys, or neither):
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
SIGNIN_EMAILS_PER_DAY=90
SUBMITS_PER_USER_PER_HOUR=30
SUBMITS_PER_IP_PER_HOUR=120
ANON_SAVES_PER_DAY=2000
SPEAKING_UPLOAD_GB_PER_DAY=3
UPLOADS_AT_ONCE=24
RECORDING_FETCHES_PER_USER_PER_HOUR=600
AUDIO_MB_PER_IP_PER_HOUR=400
FEEDBACK_PER_DAY=100
EVENTS_PER_DAY=30000
ORDERS_PER_USER_PER_HOUR=12
